/ {
    aliases {
        ambient-temp = &temp_sensor;
        light-adc = &adc;
    };
};

&sercom1 {
    status = "okay";

    bno055@29 {
        compatible = "bosch,bno055";
        reg = <0x29>;
    };

    temp_sensor: at30tse75x@4f {
        compatible = "atmel,at30tse75x";
        reg = <0x4f>;
        status = "okay";
    };
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@6 {
        reg = <6>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
