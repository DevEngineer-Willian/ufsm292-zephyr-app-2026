/ {
    chosen {
        zephyr,console = &sercom3;
        zephyr,shell-uart = &sercom3;
    };

    /* Nó instanciado seguindo estritamente o binding blink-gpio-leds.yaml */
    blink_led: blink_led {
        compatible = "blink-gpio-led";
        led-gpios = <&portb 30 GPIO_ACTIVE_HIGH>;
        status = "okay";
    };
};

&sercom3 {
    status = "okay";
};